rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pdfs/{pdfId} {
      allow read: if request.auth != null && (
        // Admin check
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        ) ||
        // Purchase check: document name is userId_pdfId
        (
          firestore.exists(/databases/(default)/documents/purchases/$(request.auth.uid + '_' + pdfId)) &&
          firestore.get(/databases/(default)/documents/purchases/$(request.auth.uid + '_' + pdfId)).data.status == 'active'
        )
      );
      // Only admins can upload/delete PDFs
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
